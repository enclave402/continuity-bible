{
  "name": "narrative-token-ssot",
  "version": "1.0.0",
  "description": "Stop AI character drift: compile-time name tokens and one character registry for long-form AI stories, graphic novels and game writing.",
  "type": "module",
  "main": "scripts/names.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "tokenize": "node scripts/tokenize.mjs",
    "render": "node scripts/render.mjs",
    "anchor": "node scripts/anchor.mjs",
    "tag": "node scripts/tag.mjs",
    "new-character": "node scripts/new-character.mjs",
    "story": "node scripts/story.mjs",
    "variants": "node scripts/story-variants.mjs",
    "check:story": "node scripts/story.mjs check examples/story",
    "verify": "node scripts/check.mjs && node --test && node scripts/story.mjs check examples/story && node scripts/check-private.mjs && node scripts/check-worklog.mjs && node scripts/research/index.mjs --check && node scripts/check-docs.mjs",
    "private": "node scripts/check-private.mjs",
    "hooks": "bash scripts/install-git-hooks.sh",
    "worklog": "node scripts/worklog-append.mjs",
    "worklog:check": "node scripts/check-worklog.mjs",
    "worklog:index": "node scripts/worklog-index.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "research:card": "node scripts/research/card.mjs",
    "research:index": "node scripts/research/index.mjs",
    "research:pack": "node scripts/research/pack.mjs",
    "research:extract": "node scripts/research/extract.mjs",
    "research:overlap": "node scripts/research/overlap.mjs",
    "research:ask": "node scripts/research/ask.mjs",
    "research:verify": "node scripts/research/verify.mjs",
    "changelog": "git cliff -o CHANGELOG.md"
  },
  "keywords": [
    "ai-storytelling",
    "narrative-engine",
    "character-consistency",
    "llm-prompt-drift",
    "cursor",
    "claude-code",
    "ssot",
    "llm",
    "ai-agents",
    "storytelling",
    "game-writing",
    "graphic-novel",
    "prompt-engineering",
    "interactive-fiction",
    "worldbuilding"
  ],
  "author": "Coach Hype (https://coachhype.com)",
  "license": "MIT",
  "homepage": "https://github.com/enclave402/narrative-token-ssot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enclave402/narrative-token-ssot.git"
  },
  "bugs": {
    "url": "https://github.com/enclave402/narrative-token-ssot/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "scripts/",
    "character-registry.json",
    "examples/",
    "research/research.config.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ]
}
