{
  "_about": {
    "what": "The package file. It names this project and lists the commands you can run with npm.",
    "why": "npm reads it. The commands here are the one place each check and tool is started from.",
    "how": "Run npm run verify to run every check. Run npm run followed by a name below to run one.",
    "next": "Run npm run verify before you finish a change."
  },
  "name": "narrative-token-ssot",
  "version": "1.0.0",
  "description": "Continuity bible for AI story characters: keep them the same from the first picture to the last. One file says who they are; a checker catches the slip.",
  "type": "module",
  "main": "scripts/names.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "tokenize": "node scripts/tokenize.mjs",
    "render": "node scripts/render.mjs",
    "anchor": "node scripts/anchor.mjs",
    "tag": "node scripts/tag.mjs",
    "new-character": "node scripts/new-character.mjs",
    "story": "node scripts/story.mjs",
    "variants": "node scripts/story-variants.mjs",
    "check:story": "node scripts/story.mjs check examples/story",
    "check:invariants": "node scripts/check-story-invariants.mjs",
    "check:affordance": "node scripts/check-affordance.mjs",
    "check:props": "node scripts/check-prop-continuity.mjs",
    "showcase": "node scripts/showcase.mjs",
    "test:showcase": "node scripts/showcase.mjs --check",
    "verify": "node scripts/check.mjs && node --test && node scripts/story.mjs check examples/story && node scripts/check-story-invariants.mjs && node scripts/check-prop-continuity.mjs && node scripts/compile-prop-index.mjs --check && npm run check:locks && node scripts/showcase.mjs --check && node scripts/check-private.mjs && node scripts/research/index.mjs --check && node scripts/check-docs.mjs && node scripts/check-self-explaining.mjs",
    "private": "node scripts/check-private.mjs",
    "hooks": "bash scripts/install-git-hooks.sh",
    "docs:check": "node scripts/check-docs.mjs",
    "research:card": "node scripts/research/card.mjs",
    "research:index": "node scripts/research/index.mjs",
    "research:pack": "node scripts/research/pack.mjs",
    "research:extract": "node scripts/research/extract.mjs",
    "research:overlap": "node scripts/research/overlap.mjs",
    "research:ask": "node scripts/research/ask.mjs",
    "research:verify": "node scripts/research/verify.mjs",
    "changelog": "git cliff -o CHANGELOG.md",
    "check:locks": "SIG_LOCK_ROOT=examples/signature-lock node scripts/check-signature-lock.mjs signature-locks.json",
    "prop-index": "node scripts/compile-prop-index.mjs",
    "check:self-explaining": "node scripts/check-self-explaining.mjs",
    "parts-map": "node scripts/parts-map.mjs"
  },
  "keywords": [
    "narrative-continuity",
    "series-bible",
    "story-bible",
    "continuity-bible",
    "character-consistency",
    "picture-book",
    "ai-art",
    "graphic-novel",
    "ai-storytelling",
    "comics",
    "storytelling",
    "worldbuilding",
    "game-writing",
    "interactive-fiction",
    "narrative-engine",
    "llm-prompt-drift",
    "prompt-engineering",
    "llm",
    "ai-agents",
    "cursor",
    "claude-code",
    "ssot"
  ],
  "author": "Coach Hype (https://coachhype.com)",
  "license": "MIT",
  "homepage": "https://github.com/enclave402/narrative-token-ssot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enclave402/narrative-token-ssot.git"
  },
  "bugs": {
    "url": "https://github.com/enclave402/narrative-token-ssot/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "scripts/",
    "character-registry.json",
    "examples/",
    "research/research.config.json",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ]
}
