# Copy to .env only if you need to override defaults. Nothing here is required.
# All research tooling talks to any OpenAI-compatible or Ollama endpoint; defaults in research/research.config.json.
# RESEARCH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RESEARCH_LLM_MODEL=llama3.1:8b
# RESEARCH_EMBED_BASE_URL=http://127.0.0.1:11434
# RESEARCH_EMBED_MODEL=qwen3-embedding:8b
# RESEARCH_API_KEY=            # only for hosted endpoints that need one
# WORKLOG_TZ=America/New_York  # timezone stamped on story-mutation log entries and research dates (default: the machine's)
# PRIVATE_TERMS_FILE=.private-terms  # extra words the publication gate must never find (gitignored)
